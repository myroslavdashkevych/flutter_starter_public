{
  "permissions": {
    "allow": [
      "Bash(fvm flutter --version)",
      "Bash(fvm flutter pub get)",
      "Bash(fvm flutter analyze*)",
      "Bash(fvm flutter test*)",
      "Bash(fvm dart format*)",
      "Bash(fvm dart run build_runner build)",
      "Bash(fvm flutter gen-l10n)",
      "Bash(fvm dart run tool/check_imports.dart*)",
      "Bash(fvm dart run tool/check_spec.dart*)",
      "Bash(fvm dart run tool/review_diff.dart*)"
    ],
    "deny": [
      "Read(**/.env*)",
      "Read(**/key.properties)",
      "Read(**/local.properties)",
      "Read(**/google-services.json)",
      "Read(**/GoogleService-Info.plist)",
      "Read(**/*service-account*.json)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Read(**/*.p8)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/*.pem)",
      "Read(**/*.mobileprovision)",
      "Read(**/ExportOptions.plist)",
      "Read(**/.npmrc)",
      "Read(**/.netrc)",
      "Read(~/.ssh/**)",
      "Read(**/.ssh/**)",
      "Read(**/id_rsa*)",
      "Read(**/id_ecdsa*)",
      "Read(**/id_ed25519*)",
      "Read(~/.gradle/gradle.properties)",
      "Read(~/.config/configstore/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.aws/**)",
      "Read(~/.docker/config.json)",
      "Edit(**/.env*)",
      "Edit(~/.claude/CLAUDE.md)",
      "Edit(~/.claude/settings*.json)",
      "Edit(~/.claude/hooks/**)",
      "Bash(flutter *)",
      "Bash(dart *)",
      "Bash(git push*)",
      "Bash(gh pr create*)",
      "Bash(firebase *)",
      "Bash(flutterfire *)",
      "Bash(git *--output*)",
      "Bash(env)",
      "Bash(printenv*)",
      "Bash(set)",
      "Bash(export -p*)",
      "Bash(declare -p*)"
    ],
    "ask": [
      "Edit(**/CLAUDE.md)",
      "Edit(**/gradle-wrapper.properties)",
      "Edit(**/local.properties)",
      "Edit(**/Package.swift)",
      "Edit(**/hook/**)",
      "Edit(**/buildSrc/**)",
      "Edit(./.claude/**)",
      "Edit(**/.github/**)",
      "Edit(**/*.g.dart)",
      "Edit(**/*.freezed.dart)",
      "Edit(**/*.gr.dart)",
      "Edit(**/*.config.dart)",
      "Edit(**/*.mocks.dart)",
      "Edit(**/lib/l10n/gen/**)",
      "Edit(**/pubspec.yaml)",
      "Edit(**/pubspec_overrides.yaml)",
      "Edit(**/analysis_options.yaml)",
      "Edit(**/build.yaml)",
      "Edit(**/l10n.yaml)",
      "Edit(**/.fvmrc)",
      "Edit(**/firebase.json)",
      "Edit(**/melos.yaml)",
      "Edit(**/*.gradle)",
      "Edit(**/*.gradle.kts)",
      "Edit(**/Podfile)",
      "Edit(**/gradle.properties)",
      "Edit(**/proguard-rules.pro)",
      "Edit(**/AndroidManifest.xml)",
      "Edit(**/Info.plist)",
      "Edit(**/*.entitlements)",
      "Edit(**/project.pbxproj)",
      "Edit(**/fastlane/**)",
      "Edit(**/Gemfile)",
      "Edit(**/.gitignore)",
      "Bash(fvm flutter pub add*)",
      "Bash(fvm flutter pub remove*)",
      "Bash(fvm flutter pub upgrade*)",
      "Bash(fvm flutter pub downgrade*)",
      "Bash(fvm dart pub add*)",
      "Bash(fvm dart pub remove*)",
      "Bash(fvm dart pub upgrade*)",
      "Bash(fvm dart pub downgrade*)",
      "Bash(fvm dart pub publish*)",
      "Bash(fvm dart pub global*)",
      "Bash(fvm use*)",
      "Bash(fvm install*)",
      "Bash(fvm remove*)",
      "Bash(fvm flutter clean*)",
      "Bash(fvm flutter create*)",
      "Bash(fvm flutter build appbundle*)",
      "Bash(fvm flutter build ipa*)",
      "Bash(fvm flutter build * --release*)",
      "Bash(fvm dart fix*)",
      "Bash(fastlane *)",
      "Bash(git commit*)",
      "Bash(git pull*)",
      "Bash(git merge*)",
      "Bash(git cherry-pick*)",
      "Bash(git stash*)",
      "Bash(git rebase*)",
      "Bash(git reset*)",
      "Bash(git restore*)",
      "Bash(git checkout*)",
      "Bash(git switch*)",
      "Bash(git clean*)",
      "Bash(git rm*)",
      "Bash(git branch -D*)",
      "Bash(git reflog expire*)",
      "Bash(git gc*)",
      "Bash(git worktree remove*)",
      "Bash(rm *)",
      "Bash(curl *)",
      "Bash(wget *)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "failIfUnavailable": true,
    "network": {
      "allowLocalBinding": true,
      "deniedDomains": ["github.com", "*.github.com"]
    },
    "filesystem": {
      "allowRead": ["./android/local.properties"],
      "allowWrite": ["~/fvm", "~/.pub-cache", "~/.dartServer", "~/.dart-tool", "~/.flutter", "~/.config/flutter"]
    }
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // \"\"'); case \"$f\" in *.dart) case \"$f\" in *.g.dart|*.freezed.dart|*.gr.dart|*.config.dart|*/lib/l10n/gen/*) ;; *) fvm dart format \"$f\" >/dev/null 2>&1 ;; esac ;; esac; exit 0"
          }
        ]
      }
    ]
  }
}
